# DEMO ONLY. Production startup is intentionally disabled in this foundation.
IESMMG_ENV=demo
IESMMG_DATABASE_URL=sqlite:///./data/iesmmg-demo.db
IESMMG_SIMULATE=true
IESMMG_SIMULATION_INTERVAL_SECONDS=45
IESMMG_SESSION_HOURS=8
IESMMG_SECURE_COOKIES=false
# Optional exact additional origin, never a wildcard with credentials.
IESMMG_EXTRA_ORIGIN=
# PostgreSQL is the production direction, not validated in this sandbox:
# IESMMG_DATABASE_URL=postgresql+psycopg://USER@HOST:5432/iesmmg
# Supply the password through an approved secret mechanism, not source control.
